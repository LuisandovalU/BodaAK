---
/**
 * Layout.astro — envoltorio global del sitio
 * ---------------------------------------------------------------------------
 * 1. Fondo de papel ÚNICO en .mobile-card ->  /images/bg-paper-1.jpg
 *    (textura empalmada sin costuras, se repite en vertical = pergamino continuo)
 * 2. Tarjeta móvil centrada ->  max-width: 500px
 * 3. @keyframes floating (ciclo de 4s) + clase .floating-flower
 *    Es la ÚNICA animación del sitio: nada se anima al hacer scroll.
 * ---------------------------------------------------------------------------
 */
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ángel & Kenia — Nuestra Boda · 04.04.27',
  description = 'Con la bendición de Dios y el amor que nos une, te invitamos a celebrar nuestra boda. Domingo 04 de abril 2027, Salón Bamboo.',
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f0e8" />
    <link rel="icon" type="image/png" href="/images/monograma.png" />
    <link rel="preload" href="/fonts/TheSeasons-Reg.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/TheSeasons-Bd.ttf" as="font" type="font/ttf" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/foto-novios-5.webp" />


  </head>

  <body>
    <div class="app-shell">
      <main class="mobile-card">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  /* ==========================================================================
     1. TOKENS DE DISEÑO
     ========================================================================== */
  :root {
    /* Paleta extraída del PDF de referencia (renderizado + muestreo) */
    --ak-marino: #263875; /* texto, iconos, florales, monograma */
    --ak-principal: #263875; /* texto secundario (mismo navy del PDF) */
    --ak-acero: #6b7d9e; /* recuadro del Dress Code */
    --ak-dresscode: #6b7d9e;
    --ak-crema: #f2f0ea; /* tono del papel, fuera de la tarjeta */
    --ak-boton: #526f9d; /* botones y cuadros del contador */
    --ak-card-max: 500px;
    --ak-card-bg: #f1eee9; /* fallback bajo la textura de papel */
  }

  /* ==========================================================================
     2. FONDO CONTINUO
     El mismo papel de la tarjeta se espeja en el body con el MISMO tamaño de
     mosaico (min(500px, 100%)) y el mismo anclaje (arriba-centro). Así la
     textura continúa sin parches blancos ni saltos debajo de la última
     sección, en los laterales del escritorio y en el rebote del scroll.
     ========================================================================== */
  html {
    background-color: var(--ak-crema);
  }

  body {
    margin: 0;
    background-color: var(--ak-crema, #f2f0ea);
    color: var(--ak-marino, #263875);
  }

  /* ==========================================================================
     3. TARJETA MÓVIL  (max-width: 500px, centrada)
     ========================================================================== */
  .app-shell {
    display: flex;
    justify-content: center;
    min-height: 100vh;
  }

  .mobile-card {
    position: relative;
    width: 100%;
    max-width: 500px;
    min-height: 100vh;
    background-color: var(--ak-crema, #f2f0ea);
    background-image: url('/images/bg-paper-1.jpg');
    background-size: 100% auto;
    background-position: center top;
    background-repeat: repeat-y;
    animation: paper-drift 24s ease-in-out infinite alternate;
    box-shadow: 0 0 50px rgba(38, 56, 117, 0.12);
    overflow: hidden;
    margin: 0 auto;
  }


  @supports (min-height: 100dvh) {
    .app-shell,
    .mobile-card {
      min-height: 100dvh;
    }
  }

  /* Movimiento muy sutil que conserva la lectura de la textura de papel. */
  @keyframes paper-drift {
    from { background-position: center 0; }
    to { background-position: center 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-card {
      animation: none;
    }
  }

  /* ==========================================================================
     Efecto de Viento Orgánico de Alta Gama ("Brisa Botánica")
     ========================================================================== */
  @keyframes wind-breeze {
    0%   { transform: translate3d(0, 0, 0) rotate(0deg); }
    12%  { transform: translate3d(3px, -4px, 0) rotate(1.4deg); }
    28%  { transform: translate3d(6px, -7px, 0) rotate(2.6deg); }
    45%  { transform: translate3d(8px, -5px, 0) rotate(2deg); }
    62%  { transform: translate3d(4px, -3px, 0) rotate(0.6deg); }
    78%  { transform: translate3d(-2px, -1px, 0) rotate(-1.2deg); }
    90%  { transform: translate3d(-4px, -2px, 0) rotate(-2deg); }
    100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  }

    @keyframes entrySlide {
      0% { opacity: 0; transform: translateY(20px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .enter {
      opacity: 0;
      animation: entrySlide 0.8s ease-out forwards;
    }
    .elevated {
      box-shadow: 0 8px 20px rgba(0,0,0,0.12),
                  0 4px 8px rgba(0,0,0,0.08);
      transition: box-shadow .3s ease;
    }
    .elevated:hover {
      box-shadow: 0 12px 28px rgba(0,0,0,0.16),
                  0 6px 12px rgba(0,0,0,0.10);
    }
    .grow-on-hover {
      transition: scale .3s ease, box-shadow .3s ease;
    }
    .grow-on-hover:hover {
      scale: 1.05;
      box-shadow: 0 12px 30px rgba(0,0,0,0.12),
                  0 6px 12px rgba(0,0,0,0.08);
    }
    /* Script for scroll reveal */
    .scroll-reveal { opacity: 0; }


  .floating-flower {
    will-change: transform;
    pointer-events: none;
    user-select: none;
    transform-origin: var(--flower-origin, bottom center);
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-flower {
      animation: none;
    }
  }

  /* ==========================================================================
     5. UTILIDADES COMPARTIDAS POR LAS SECCIONES
     ========================================================================== */
  .seccion {
    position: relative;
    /* Transparente a propósito: el pergamino del Layout debe fluir sin cortes. */
    background: transparent;
    padding: 2.75rem 1.5rem;
    text-align: center;
  }

  .titulo-seccion {
    margin: 0 0 0.3rem;
    font-family: 'Andasia', 'Sloop Script Pro', cursive;
    font-weight: 400;
    font-size: clamp(2.5rem, 13vw, 3.4rem);
    line-height: 1.08;
    color: var(--ak-marino);
  }

  .texto {
    max-width: 34ch;
    margin: 0 auto;
    font-family: 'The Seasons', 'Cormorant Garamond', serif;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--ak-principal);
  }

  .btn-primario {
    display: block;
    width: 100%;
    padding: 0.95rem 1.1rem;
    border: 0;
    /* El PDF usa botones planos de esquinas rectas, sin redondeo */
    border-radius: 0;
    background: var(--ak-boton);
    color: #fff;
    font-family: 'The Seasons', 'Cormorant Garamond', serif;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      filter 0.18s ease,
      transform 0.18s ease;
  }
  .btn-primario:hover {
    filter: brightness(1.08);
  }
  .btn-primario:active {
    transform: scale(0.99);
  }
  .btn-primario:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .dato {
    margin: 0;
    font-family: 'The Seasons', 'Cormorant Garamond', serif;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--ak-marino);
  }
  .dato__label {
    font-weight: 700;
    color: var(--ak-principal);
  }
  .dato__valor {
    font-variant-numeric: tabular-nums;
  }
  .mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

/* ============================================================
   Scroll Reveal — propiedades animadas por el script
   ============================================================ */
[data-reveal] {
  will-change: opacity, transform, filter;
  transition: opacity 0.05s linear, transform 0.05s linear, filter 0.05s linear;
}

/* ============================================================
   Liquid Glass — vidrio esmerilado premium
   ============================================================ */
[data-liquid-glass] {
  backdrop-filter: blur(18px) saturate(180%);
  -webkit-backdrop-filter: blur(18px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.28) !important;
  box-shadow:
    0 8px 32px rgba(38, 56, 117, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.45),
    inset 0 -1px 0 rgba(0, 0, 0, 0.06);
}

/* ============================================================
   Floating flower — el viento se activa DESPUÉS de posicionar
   ============================================================ */
.floating-flower {
  animation: none !important;
}
.floating-flower.floating-revealed {
  animation: wind-breeze 9s ease-in-out infinite !important;
  animation-delay: var(--float-delay, 0s) !important;
}

/* ============================================================
   Accesibilidad — reducción de movimiento
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  [data-reveal] {
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
    transition: none !important;
  }
  .floating-flower,
  .floating-flower.floating-revealed {
    animation: none !important;
  }
}
</style>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const REVEAL_ELEMENTS = document.querySelectorAll('[data-reveal]');
    let ticking = false;
    // Estado inicial: ocultar todos los elementos revelables
    REVEAL_ELEMENTS.forEach((el) => {
      const dir = el.getAttribute('data-reveal');
      el.style.opacity = '0';
      el.style.filter = 'blur(10px)';
      if (dir === 'slide-left')  el.style.transform = 'translateX(-80px)';
      if (dir === 'slide-right') el.style.transform = 'translateX(80px)';
      if (dir === 'fade-up')     el.style.transform = 'translateY(40px)';
      if (dir === 'slide-up')    el.style.transform = 'translateY(60px)';
    });
    function updateReveal() {
      const vh = window.innerHeight;
      REVEAL_ELEMENTS.forEach((el) => {
        if (el.dataset.revealed === 'true') return;
        const rect = el.getBoundingClientRect();
        const triggerStart = vh;
        const triggerEnd   = vh * 0.82;
        // t = 0 (fuera) → 1 (completamente visible)
        let t = (triggerStart - rect.top) / (triggerStart - triggerEnd);
        t = Math.max(0, Math.min(1, t));
        const dir = el.getAttribute('data-reveal');
        el.style.opacity = t.toFixed(3);
        el.style.filter  = `blur(${((1 - t) * 10).toFixed(2)}px)`;
        if (dir === 'slide-left')  el.style.transform = `translateX(${(1 - t) * -80}px)`;
        if (dir === 'slide-right') el.style.transform = `translateX(${(1 - t) * 80}px)`;
        if (dir === 'fade-up')     el.style.transform = `translateY(${(1 - t) * 40}px)`;
        if (dir === 'slide-up')    el.style.transform = `translateY(${(1 - t) * 60}px)`;
        if (t >= 1) {
          el.style.opacity   = '1';
          el.style.transform = 'none';
          el.style.filter    = 'blur(0px)';
          el.dataset.revealed = 'true';
          // Reactivar la animación flotante si la tenía
          if (el.classList.contains('floating-flower')) {
            el.classList.add('floating-revealed');
          }
        }
      });
        // Activate wind for floating flowers without data-reveal
        const FLOWERS = document.querySelectorAll('.floating-flower:not([data-reveal])');
        FLOWERS.forEach((fl) => {
          if (fl.classList.contains('floating-revealed')) return;
          const rect = fl.getBoundingClientRect();
          if (rect.bottom > 0 && rect.top < vh) {
            fl.classList.add('floating-revealed');
          }
        });
        ticking = false;
    }
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(updateReveal);
        ticking = true;
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateReveal(); // Elementos ya visibles al cargar
  });
</script>


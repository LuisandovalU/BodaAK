---
/**
 * index.astro — orden de las secciones dentro del pergamino (500px)
 * ---------------------------------------------------------------------------
 * Orden fiel al PDF de referencia (3 páginas de 810x5999pt en una tira):
 *   Portada → Nombres+Contador → Detalles → Dress Code → Regalos →
 *   Ubicación → Monograma → Galería → Confirmación de asistencia →
 *   Importante → Foto final
 *
 * La lógica de confirmación vive completa en RSVP.astro.
 * ---------------------------------------------------------------------------
 */
import Layout from '../layouts/Layout.astro';

import Hero from '../components/Hero.astro';
import S2Names from '../components/S2_Names.astro';
import Detalles from '../components/Detalles.astro';
import DressCode from '../components/DressCode.astro';
import Gifts from '../components/Gifts.astro';
import S5Ubicacion from '../components/S5_Ubicacion.astro';
import Monograma from '../components/Monograma.astro';
import S8Galeria from '../components/S8_Galeria.astro';
import RSVP from '../components/RSVP.astro';
import ImportantNotes from '../components/ImportantNotes.astro';
import FotoFinal from '../components/FotoFinal.astro';
---
<Layout>
  <Hero />
  <S2Names />
  <Detalles />
  <DressCode />
  <Gifts />
  <S5Ubicacion />
  <Monograma />
  <S8Galeria />
  <RSVP />
  <ImportantNotes />
  <FotoFinal />
</Layout>

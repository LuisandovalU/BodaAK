---
/**
 * Monograma.astro — Monograma gigante "AyK" (sección 7 del PDF)
 * ---------------------------------------------------------------------------
 * En el PDF, antes de la galería de fotos hay un monograma enorme en script.
 * ---------------------------------------------------------------------------
 */
---
<section class="seccion monograma relative overflow-hidden" id="monograma" aria-label="Monograma de Angel y Kenia">
  <!-- Flor 13: Decoración floral orgánica en Monograma -->
  <img
    src="/images/flor-13.webp"
    alt=""
    aria-hidden="true"
    class="flor-monograma floating-flower"
    style="--flower-origin: top center; --float-delay: 2.5s;"
  />

  <img
    src="/images/monograma.png"
    alt="Monograma de Angel y Kenia"
    class="monograma__imagen relative z-10"
    loading="lazy"
  />
</section>

<style>
  .monograma {
    position: relative;
    padding-top: 2.4rem;
    padding-bottom: 1.4rem;
  }

    .flor-monograma[data-astro-cid-hjjoe6gl] {
        position: absolute;
        top: 0;
        left: 103%;
        translate: -50% 0;
        width: 65%;
        max-width: 260px;
        height: auto;
        opacity: .75;
        z-index: 0;
        pointer-events: none;
    }

  .monograma__imagen {
    position: relative;
    display: block;
    width: min(86%, 360px);
    height: auto;
    margin-left: -80px;
    margin-right: auto;
  }
</style>

---
/**
 * S8_Galeria.astro — Galería de fotografías (fiel al PDF)
 * ---------------------------------------------------------------------------
 * Fotos escalonadas, cada una dentro de un marco fino con 4 esquinas de
 * volutas ornamentales. Las 3 fotografías rotan continuamente.
 * ---------------------------------------------------------------------------
 */
const fotosRotativas = Array.from({ length: 20 }, (_, index) => {
  const numero = index + 1;
  return {
    src: `/images/foto-novios-${numero}.webp`,
    alt: `Fotografía de Ángel y Kenia ${numero}`,
  };
});

const fotos = [
  {
    src: "/images/foto-novios-1.webp",
    alt: "Ángel y Kenia abrazados de espaldas",
    clase: "foto-espaldas",
    rotativa: true,
  },
  {
    src: "/images/foto-novios-2.webp",
    alt: "Ángel y Kenia bailando juntos",
    clase: "foto-baile",
    rotativa: true,
  },
  {
    src: "/images/foto-novios-3.webp",
    alt: "Ángel y Kenia sonriendo durante su sesión",
    clase: "foto-sonrisa",
    rotativa: true,
  },
];
---

<section class="seccion galeria relative overflow-hidden" id="galeria">
  <!-- Flor decorativa 14 en la galería -->
  <img
    loading="lazy"
    decoding="async"
    src="/images/flor-15.webp"
    alt=""
    aria-hidden="true"
    class="flor-galeria floating-flower"
    data-reveal="slide-left"
    style="--flower-origin: bottom right; --float-delay: 1.8s;"
  />

  <div class="galeria-fotos" aria-label="Fotografías de Ángel y Kenia">
    {
      fotos.map((f, i) => (
        <figure
          class={`foto ${f.clase}`}
          data-reveal={i % 2 === 0 ? 'slide-left' : 'slide-right'}
        >
          {i === 0 && (
            <img
              loading="lazy"
              decoding="async"
              class="marco-esq marco-esq--tl"
              src="/images/marco-tl.png"
              alt=""
              aria-hidden="true"
            />
          )}
          {i === 2 && (
            <img
              loading="lazy"
              decoding="async"
              class="marco-esq marco-esq--br"
              src="/images/marco-br.png"
              alt=""
              aria-hidden="true"
            />
          )}

          <img
            class="foto__imagen"
            src={f.src}
            alt={f.alt}
            loading="lazy"
            decoding="async"
            data-photo-rotator={f.rotativa ? JSON.stringify(fotosRotativas) : undefined}
          />
        </figure>
      ))
    }
  </div>
</section>

<style>
  .galeria {
    position: relative;
    padding-top: 2.25rem;
    padding-bottom: 2.5rem;
  }

  .flor-galeria {
    position: absolute;
    top: 45%;
    left: -11%;
    width: 47%;
    max-width: 190px;
    height: auto;
    opacity: 0.85;
    z-index: 0;
    pointer-events: none;
  }

  .galeria-fotos {
    display: flex;
    flex-direction: column;
    gap: 1.7rem;
    width: min(100%, 350px);
    margin: 0 auto;
  }

  .foto {
    position: relative;
    width: 57%;
    margin: 0;
    padding: 7px;
    border: 1px solid rgba(38, 56, 117, 0.4);
    background: #e9e4da; /* Fondo cálido papel para que no se vea blanco al cambiar */
    overflow: hidden;
  }
  .foto-espaldas {
    align-self: flex-start;
    margin-left: 7%;
  }
  .foto-baile {
    align-self: flex-end;
    margin-right: 7%;
  }
  .foto-sonrisa {
    align-self: flex-start;
    margin-left: 18%;
  }

  .foto__imagen {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    opacity: 1;
    transform: scale(1);
    filter: blur(0px);
    transition: opacity 700ms cubic-bezier(0.4, 0, 0.2, 1),
                transform 700ms cubic-bezier(0.4, 0, 0.2, 1),
                filter 700ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity, transform, filter;
  }
  .foto__imagen--cambiando {
    opacity: 0;
    transform: scale(1.04);
    filter: blur(4px);
  }
  .foto-espaldas .foto__imagen {
    aspect-ratio: 0.78;
  }
  .foto-baile .foto__imagen {
    aspect-ratio: 0.9;
  }
  .foto-sonrisa .foto__imagen {
    aspect-ratio: 0.86;
  }

  .marco-esq {
    position: absolute;
    z-index: 1;
    width: 30px;
    height: 30px;
    object-fit: contain;
    pointer-events: none;
  }
  .marco-esq--tl {
    top: -15px;
    left: -15px;
  }
  .marco-esq--tr {
    top: -15px;
    right: -15px;
  }
  .marco-esq--bl {
    bottom: -15px;
    left: -15px;
  }
  .marco-esq--br {
    bottom: -15px;
    right: -15px;
  }
</style>

<script>
  const rotators = Array.from(document.querySelectorAll<HTMLImageElement>('[data-photo-rotator]'));

  if (rotators.length) {
    type Foto = { src: string; alt: string };

    rotators.forEach((image, position) => {
      const photos: Foto[] = JSON.parse(image.dataset.photoRotator || '[]');
      if (photos.length < 2) return;

      let current = Math.max(0, photos.findIndex((photo) => photo.src === image.getAttribute('src')));
      // Tiempos desfasados para que no cambien al mismo tiempo
      const interval = 4500 + position * 1400;

      window.setInterval(() => {
        if (document.hidden) return;

        image.classList.add('foto__imagen--cambiando');

        window.setTimeout(() => {
          const visibleElsewhere = new Set(
            rotators
              .filter((other) => other !== image)
              .map((other) => other.getAttribute('src'))
              .filter(Boolean),
          );

          let attempts = 0;
          do {
            current = (current + position + 1) % photos.length;
            attempts += 1;
          } while (visibleElsewhere.has(photos[current].src) && attempts < photos.length);

          const nextPhoto = photos[current];
          
          // Pre-cargar la imagen en memoria antes de mostrarla para evitar parpadeos
          const preload = new Image();
          preload.src = nextPhoto.src;
          const aplicarNuevaFoto = () => {
            image.setAttribute('src', nextPhoto.src);
            image.setAttribute('alt', nextPhoto.alt);
            // Pequeño frame para reactivar la animación suavemente
            requestAnimationFrame(() => {
              image.classList.remove('foto__imagen--cambiando');
            });
          };

          if (preload.complete) {
            aplicarNuevaFoto();
          } else {
            preload.onload = aplicarNuevaFoto;
            preload.onerror = aplicarNuevaFoto;
          }
        }, 700);
      }, interval);
    });
  }
</script>

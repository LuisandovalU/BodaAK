---
/**
 * S8_Galeria.astro — Galería de fotografías (fiel al PDF)
 * ---------------------------------------------------------------------------
 * Fotos escalonadas, cada una dentro de un marco fino con 4 esquinas de
 * volutas ornamentales. La foto final se movió a FotoFinal.astro.
 * ---------------------------------------------------------------------------
 */
const fotos = [
  { src: '/images/foto-novios-1.webp', alt: 'Ángel y Kenia abrazados de espaldas', clase: 'foto-espaldas' },
  { src: '/images/foto-novios-2.webp', alt: 'Ángel y Kenia bailando juntos', clase: 'foto-baile' },
  { src: '/images/foto-novios-3.webp', alt: 'Ángel y Kenia sonriendo durante su sesión', clase: 'foto-sonrisa' },
];
---
<section class="seccion galeria relative overflow-hidden" id="galeria">
  <!-- Flor decorativa 14 en la galería -->
  <img
    src="/images/flor-14.webp"
    alt=""
    aria-hidden="true"
    class="flor-galeria floating-flower"
    style="--flower-origin: bottom right; --float-delay: 1.8s;"
  />

  <div class="galeria-fotos" aria-label="Fotografías de Ángel y Kenia">
    {
      fotos.map((f) => (
        <figure class={`foto ${f.clase}`}>
          <img class="marco-esq marco-esq--tl" src="/images/marco-tl.png" alt="" aria-hidden="true" />
          <img class="marco-esq marco-esq--tr" src="/images/marco-tr.png" alt="" aria-hidden="true" />
          <img class="marco-esq marco-esq--bl" src="/images/marco-bl.png" alt="" aria-hidden="true" />
          <img class="marco-esq marco-esq--br" src="/images/marco-br.png" alt="" aria-hidden="true" />
          <img class="foto__imagen" src={f.src} alt={f.alt} loading="lazy" />
        </figure>
      ))
    }
  </div>
</section>

<style>
  .galeria {
    position: relative;
    padding-top: 2.25rem;
    padding-bottom: 2.5rem;
  }

  .flor-galeria {
    position: absolute;
    top: 31%;
    left: -11%;
    width: 47%;
    max-width: 190px;
    height: auto;
    opacity: 0.85;
    z-index: 0;
    pointer-events: none;
  }

  .galeria-fotos {
    display: flex;
    flex-direction: column;
    gap: 1.7rem;
    width: min(100%, 350px);
    margin: 0 auto;
  }

  .foto {
    position: relative;
    width: 57%;
    margin: 0;
    padding: 7px;
    border: 1px solid rgba(38, 56, 117, 0.4);
    background: transparent;
  }
  .foto-espaldas {
    align-self: flex-start;
    margin-left: 7%;
  }
  .foto-baile {
    align-self: flex-end;
    margin-right: 7%;
  }
  .foto-sonrisa {
    align-self: flex-start;
    margin-left: 18%;
  }

  .foto__imagen {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .foto-espaldas .foto__imagen {
    aspect-ratio: 0.78;
  }
  .foto-baile .foto__imagen {
    aspect-ratio: 0.9;
  }
  .foto-sonrisa .foto__imagen {
    aspect-ratio: 0.86;
  }

  .marco-esq {
    position: absolute;
    z-index: 1;
    width: 30px;
    height: 30px;
    object-fit: contain;
    pointer-events: none;
  }
  .marco-esq--tl {
    top: -15px;
    left: -15px;
  }
  .marco-esq--tr {
    top: -15px;
    right: -15px;
  }
  .marco-esq--bl {
    bottom: -15px;
    left: -15px;
  }
  .marco-esq--br {
    bottom: -15px;
    right: -15px;
  }
</style>

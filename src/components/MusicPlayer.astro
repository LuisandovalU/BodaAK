<section class="music-player" aria-label="Nuestra canción">
  <button id="music-toggle" class="music-player__button" type="button" aria-pressed="false" aria-label="Activar música">
    <span class="music-player__disc" aria-hidden="true">
      <svg class="music-player__icon music-player__icon--play" viewBox="0 0 24 24"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.9-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z"/></svg>
      <svg class="music-player__icon music-player__icon--pause" viewBox="0 0 24 24"><rect x="6.5" y="5" width="3.6" height="14" rx="1.2"/><rect x="13.9" y="5" width="3.6" height="14" rx="1.2"/></svg>
    </span>
    <span class="music-player__text">
      <span class="music-player__caption" id="music-toggle-label">Escuchar nuestra canción</span>
      <span class="music-player__eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </span>
  </button>
  <p id="music-status" class="sr-only" aria-live="polite"></p>
  <audio id="wedding-song" preload="metadata" loop>
    <source src="/audio/enchanted.mp3" type="audio/mpeg" />
  </audio>
</section>

<style>
  .music-player {
    position: relative;
    z-index: 3;
    padding: 0.4rem 0 1rem;
    text-align: center;
  }

  .music-player__button {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ak-marino, #263875);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .music-player__disc {
    position: relative;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--ak-marino, #263875);
    color: #fff;
    box-shadow: 0 6px 18px rgba(38, 56, 117, 0.28);
    transition: transform 250ms ease, box-shadow 250ms ease, background-color 250ms ease;
  }
  /* Anillo que "late" para invitar a tocar mientras está en pausa */
  .music-player__disc::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(38, 56, 117, 0.45);
    animation: pulse 2s ease-out infinite;
  }
  .music-player__disc::after {
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px dashed rgba(38, 56, 117, 0.3);
  }
  .music-player__button:hover .music-player__disc { transform: scale(1.07); box-shadow: 0 8px 22px rgba(38, 56, 117, 0.36); }
  .music-player__button:active .music-player__disc { transform: scale(0.95); }
  .music-player__button:focus-visible { outline: none; }
  .music-player__button:focus-visible .music-player__disc { box-shadow: 0 0 0 4px rgba(82, 111, 157, 0.35); }

  .music-player__icon { grid-area: 1 / 1; width: 26px; height: 26px; fill: currentColor; transition: opacity 200ms ease, transform 200ms ease; }
  .music-player__icon--play { transform: translateX(2px); } /* centrado óptico del triángulo */
  .music-player__icon--pause { opacity: 0; transform: scale(0.6); }

  .music-player__text { display: inline-flex; align-items: center; gap: 0.45rem; min-height: 14px; }

  .music-player__caption {
    font-family: "Cormorant Garamond", serif;
    font-weight: 500;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .music-player__eq { display: none; gap: 2px; align-items: flex-end; height: 12px; }
  .music-player__eq i { display: block; width: 2px; height: 100%; border-radius: 1px; background: currentColor; transform-origin: bottom; animation: eq 1s ease-in-out infinite; }
  .music-player__eq i:nth-child(2) { animation-delay: -0.3s; }
  .music-player__eq i:nth-child(3) { animation-delay: -0.6s; }
  .music-player__eq i:nth-child(4) { animation-delay: -0.15s; }

  .is-playing .music-player__icon--play { opacity: 0; transform: scale(0.6); }
  .is-playing .music-player__icon--pause { opacity: 1; transform: none; }
  .is-playing .music-player__disc::before { animation: none; opacity: 0; }
  .is-playing .music-player__disc::after { animation: spin 12s linear infinite; }
  .is-playing .music-player__eq { display: inline-flex; }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @keyframes eq { 0%, 100% { transform: scaleY(0.3); } 50% { transform: scaleY(1); } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes pulse { 0% { transform: scale(1); opacity: 0.9; } 100% { transform: scale(1.55); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .music-player__eq i, .music-player__disc::before, .is-playing .music-player__disc::after { animation: none; } }
</style>
<script>
  const audio = document.getElementById("wedding-song") as HTMLAudioElement | null;
  const button = document.getElementById("music-toggle") as HTMLButtonElement | null;
  const label = document.getElementById("music-toggle-label");
  const status = document.getElementById("music-status");
  const player = document.querySelector(".music-player");
  let pausedByGuest = false;
  let autoPlayAttempted = false;

  function actualizarEstado(reproduciendo: boolean) {
    if (button) button.setAttribute("aria-pressed", String(reproduciendo));
    if (button) button.setAttribute("aria-label", reproduciendo ? "Pausar música" : "Activar música");
    button?.classList.toggle("is-playing", reproduciendo);
    if (label) label.textContent = reproduciendo ? "Sonando · toca para pausar" : "Escuchar nuestra canción";
    if (status) status.textContent = reproduciendo ? "Reproduciendo" : "";
  }

  async function reproducirAlLlegar() {
    if (!audio || pausedByGuest || autoPlayAttempted) return;
    autoPlayAttempted = true;
    try {
      await audio.play();
    } catch {
      if (status) status.textContent = "Activa la música con el botón.";
    }
  }

  button?.addEventListener("click", async () => {
    if (!audio) return;
    try {
      if (audio.paused) {
        pausedByGuest = false;
        await audio.play();
      } else {
        pausedByGuest = true;
        audio.pause();
      }
    } catch {
      if (status) status.textContent = "No fue posible reproducir la canción.";
    }
  });

  audio?.addEventListener("play", () => actualizarEstado(true));
  audio?.addEventListener("pause", () => actualizarEstado(false));
  audio?.addEventListener("ended", () => actualizarEstado(false));

  if (player) {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry?.isIntersecting) reproducirAlLlegar();
    }, { threshold: 0.65 });
    observer.observe(player);
  }
</script>

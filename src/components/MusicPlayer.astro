<section class="music-player" aria-label="Nuestra canción">
  <button id="music-toggle" class="music-player__button" type="button" aria-pressed="false" aria-label="Activar música">
    <span class="music-player__disc" aria-hidden="true">
      <svg id="music-toggle-icon" class="music-player__note" viewBox="0 0 24 24"><path d="M9 18.5a2.5 2.5 0 1 1-2-2.45V5.5l11-2v11.05a2.5 2.5 0 1 1-2-2.45V7.1l-7 1.27Z"/></svg>
      <span class="music-player__eq"><i></i><i></i><i></i><i></i></span>
    </span>
    <span class="music-player__caption" id="music-toggle-label">nuestra canción</span>
  </button>
  <p id="music-status" class="sr-only" aria-live="polite"></p>
  <audio id="wedding-song" preload="metadata" loop>
    <source src="/audio/enchanted.mp3" type="audio/mpeg" />
  </audio>
</section>

<style>
  .music-player {
    position: relative;
    z-index: 3;
    padding: 0.4rem 0 1rem;
    text-align: center;
  }

  .music-player__button {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ak-marino, #263875);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .music-player__disc {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(38, 56, 117, 0.45);
    background: rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(2px);
    transition: transform 250ms ease, border-color 250ms ease, background-color 250ms ease;
  }
  .music-player__disc::after {
    content: "";
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1px dashed rgba(38, 56, 117, 0.22);
  }
  .music-player__button:hover .music-player__disc { transform: scale(1.06); background: rgba(255, 255, 255, 0.6); }
  .music-player__button:focus-visible { outline: none; }
  .music-player__button:focus-visible .music-player__disc { box-shadow: 0 0 0 3px rgba(82, 111, 157, 0.3); }

  .music-player__note { width: 17px; height: 17px; fill: currentColor; transition: opacity 200ms ease; }

  .music-player__eq { position: absolute; display: none; gap: 2px; align-items: flex-end; height: 14px; }
  .music-player__eq i { display: block; width: 2px; height: 100%; border-radius: 1px; background: currentColor; transform-origin: bottom; animation: eq 1s ease-in-out infinite; }
  .music-player__eq i:nth-child(2) { animation-delay: -0.3s; }
  .music-player__eq i:nth-child(3) { animation-delay: -0.6s; }
  .music-player__eq i:nth-child(4) { animation-delay: -0.15s; }

  .music-player__caption {
    font-family: "The Seasons", "Cormorant Garamond", serif;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .is-playing .music-player__note { display: none; }
  .is-playing .music-player__eq { display: flex; }
  .is-playing .music-player__disc::after { animation: spin 12s linear infinite; }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @keyframes eq { 0%, 100% { transform: scaleY(0.3); } 50% { transform: scaleY(1); } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .music-player__eq i, .is-playing .music-player__disc::after { animation: none; } }
</style>
<script>
  const audio = document.getElementById("wedding-song") as HTMLAudioElement | null;
  const button = document.getElementById("music-toggle") as HTMLButtonElement | null;
  const label = document.getElementById("music-toggle-label");
  const status = document.getElementById("music-status");
  const player = document.querySelector(".music-player");
  let pausedByGuest = false;
  let autoPlayAttempted = false;

  function actualizarEstado(reproduciendo: boolean) {
    if (button) button.setAttribute("aria-pressed", String(reproduciendo));
    if (button) button.setAttribute("aria-label", reproduciendo ? "Pausar música" : "Activar música");
    button?.classList.toggle("is-playing", reproduciendo);
    if (label) label.textContent = reproduciendo ? "sonando" : "nuestra canción";
    if (status) status.textContent = reproduciendo ? "Reproduciendo" : "";
  }

  async function reproducirAlLlegar() {
    if (!audio || pausedByGuest || autoPlayAttempted) return;
    autoPlayAttempted = true;
    try {
      await audio.play();
    } catch {
      if (status) status.textContent = "Activa la música con el botón.";
    }
  }

  button?.addEventListener("click", async () => {
    if (!audio) return;
    try {
      if (audio.paused) {
        pausedByGuest = false;
        await audio.play();
      } else {
        pausedByGuest = true;
        audio.pause();
      }
    } catch {
      if (status) status.textContent = "No fue posible reproducir la canción.";
    }
  });

  audio?.addEventListener("play", () => actualizarEstado(true));
  audio?.addEventListener("pause", () => actualizarEstado(false));
  audio?.addEventListener("ended", () => actualizarEstado(false));

  if (player) {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry?.isIntersecting) reproducirAlLlegar();
    }, { threshold: 0.65 });
    observer.observe(player);
  }
</script>

---
// S2 — Nombres + Countdown + Versículo
---
<section class="bloque relative overflow-hidden" id="nombres" style="padding: 2.5rem 1.4rem 3rem;">
  <!-- Ramo lateral decorativo flotante -->
  <div class="absolute -right-6 top-16 w-28 opacity-75 pointer-events-none select-none">
    <img src="/assets/ramo_vertical_lateral.webp" alt="" class="w-full h-auto" />
  </div>

  <div class="relative z-10">
    <!-- Nombres en caligrafía original -->
    <div class="my-6 flex justify-center">
      <img
        src="/assets/nombres_angel_y_kenia.webp"
        alt="Ángel y Kenia"
        class="w-full max-w-[320px] h-auto object-contain select-none"
      />
    </div>

    <!-- Cuenta regresiva -->
    <div class="mt-8 mb-4">
      <p class="font-serif italic text-base text-[#263875] tracking-widest mb-1">the countdown</p>
      <p class="font-script text-3xl text-[#263875] mb-4">Forever begins in</p>

      <div
        id="countdown"
        data-fecha="2027-04-04T15:30:00-06:00"
        class="grid grid-cols-4 gap-2.5 max-w-[320px] mx-auto"
      >
        <div class="flex flex-col items-center">
          <div id="cd-d" class="w-full bg-[#526f9d] text-white font-serif font-bold text-2xl py-3">00</div>
          <span class="font-serif text-xs text-[#263875] mt-1.5 uppercase tracking-wider font-semibold">Días</span>
        </div>
        <div class="flex flex-col items-center">
          <div id="cd-h" class="w-full bg-[#526f9d] text-white font-serif font-bold text-2xl py-3">00</div>
          <span class="font-serif text-xs text-[#263875] mt-1.5 uppercase tracking-wider font-semibold">Horas</span>
        </div>
        <div class="flex flex-col items-center">
          <div id="cd-m" class="w-full bg-[#526f9d] text-white font-serif font-bold text-2xl py-3">00</div>
          <span class="font-serif text-xs text-[#263875] mt-1.5 uppercase tracking-wider font-semibold">Minutos</span>
        </div>
        <div class="flex flex-col items-center">
          <div id="cd-s" class="w-full bg-[#526f9d] text-white font-serif font-bold text-2xl py-3">00</div>
          <span class="font-serif text-xs text-[#263875] mt-1.5 uppercase tracking-wider font-semibold">Segundos</span>
        </div>
      </div>
    </div>

    <!-- Cita bíblica -->
    <div class="my-8 px-4">
      <p class="font-serif italic text-base text-[#263875] leading-relaxed max-w-[32ch] mx-auto">
        “Ahora, pues, permanecen la fe, la esperanza y el amor. Pero el amor es el más importante.”
      </p>
      <p class="font-serif text-sm text-[#263875] tracking-widest mt-2 uppercase font-medium">
        1 Corintios 13:13
      </p>
    </div>

    <!-- Fotografía de manos y anillos del diseño de referencia -->
    <div class="foto-compromiso relative mx-auto max-w-[340px] overflow-hidden">
      <img
        src="/assets/foto_anillos.webp"
        alt="Manos de Ángel y Kenia con sus anillos"
        class="block w-full h-auto object-cover"
      />
    </div>
  </div>
</section>

<style>
  .foto-compromiso { width: min(100%, 340px); }
</style>

<script>
  const root = document.getElementById('countdown');
  const target = new Date(root?.dataset.fecha || '2027-04-04T15:30:00-06:00').getTime();
  const d = document.getElementById('cd-d');
  const h = document.getElementById('cd-h');
  const m = document.getElementById('cd-m');
  const s = document.getElementById('cd-s');

  function tick() {
    const diff = target - Date.now();
    if (diff <= 0) return;
    const dd = Math.floor(diff / 864e5);
    const hh = Math.floor((diff % 864e5) / 36e5);
    const mm = Math.floor((diff % 36e5) / 6e4);
    const ss = Math.floor((diff % 6e4) / 1e3);
    if (d) d.textContent = String(dd).padStart(2, '0');
    if (h) h.textContent = String(hh).padStart(2, '0');
    if (m) m.textContent = String(mm).padStart(2, '0');
    if (s) s.textContent = String(ss).padStart(2, '0');
  }
  tick();
  setInterval(tick, 1000);
</script>

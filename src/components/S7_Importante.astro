---
// S7 — Importante (avisos)
const avisos = [
  {
    icon: '/assets/icon_champagne.webp',
    titulo: 'FIESTA PARA ADULTOS',
    texto: 'Amamos a los niños pero es un evento para adultos, agradecemos tu comprensión para dejarlos en casa.'
  },
  {
    icon: '/assets/icon_parking.webp',
    titulo: 'VALET PARKING $70',
    texto: 'No hay estacionamiento.'
  },
  {
    icon: '/assets/icon_audio_taylorswift.webp',
    titulo: 'MOMENTO ESPECIAL',
    texto: 'Conocer de memoria la letra de Love Story de Taylor Swift.'
  },
  {
    icon: '/assets/icon_corazon.webp',
    titulo: 'INVITACIÓN INTRANSFERIBLE',
    texto: 'Tu boleto e invitación es personal. Gracias.'
  },
];
---
<section class="bloque bg-fondo-2 relative overflow-hidden" id="importante" style="padding: 2.5rem 1.4rem 3rem;">
  <!-- Floral superior derecho (como el PDF) -->
  <img
    src="/assets/flor_tallo_hortensia.webp"
    alt=""
    class="absolute -right-7 -top-4 w-36 sm:w-44 h-auto opacity-90 pointer-events-none select-none"
  />

  <!-- Título Importante en caligrafía original -->
  <div class="flex justify-center mb-6">
    <img
      src="/assets/caligrafia_importante.webp"
      alt="Importante"
      class="w-56 sm:w-64 h-auto object-contain select-none"
    />
  </div>

  <!-- Lista de avisos con línea vertical guía e íconos originales -->
  <div class="text-left max-w-[340px] mx-auto relative pl-7 border-l-2 border-[#1a3256]/30 space-y-6">
    {avisos.map((a) => (
      <div class="relative flex items-start gap-3">
        <!-- Punto azul en la línea vertical -->
        <span class="absolute -left-[33px] top-1.5 w-2.5 h-2.5 rounded-full bg-[#1a3256]" />
        
        <div class="w-7 h-7 flex-shrink-0 flex items-center justify-center pt-0.5">
          <img src={a.icon} alt="" class="max-w-full max-h-full object-contain select-none pointer-events-none" />
        </div>
        <div class="text-sm font-serif">
          <strong class="text-[#1a3256] tracking-wider block font-bold text-[0.88rem] mb-0.5">{a.titulo}</strong>
          <span class="text-[#2c4a7c] leading-relaxed block text-[0.85rem]">{a.texto}</span>
        </div>
      </div>
    ))}
  </div>
</section>

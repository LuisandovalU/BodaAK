---
// S3 — Detalles del evento + Dress Code
const sugeridos = ['#D9A066', '#D8A7C3', '#8E7CC3', '#F4D35E', '#5B7A3A', '#111111', '#5C3317', '#8A8D90', '#8B5E34'];
const prohibidos = ['#1A3256', '#2C4A7C', '#7A94B5', '#A9BDD9', '#E8D5CC', '#FFFFFF'];
---
<section class="bloque bg-fondo-2 relative overflow-hidden" id="detalles" style="padding: 2.5rem 1.4rem 3rem;">
  <!-- Título Detalles en caligrafía original, flanqueado por florales (como el PDF) -->
  <div class="relative flex justify-center my-4">
    <img src="/assets/boda_asset_16.webp" alt="" class="absolute -left-4 top-1 w-20 sm:w-24 opacity-80 select-none pointer-events-none" />
    <img
      src="/assets/caligrafia_detalles.webp"
      alt="Detalles"
      class="w-56 sm:w-64 h-auto object-contain select-none relative z-10"
    />
    <img src="/assets/boda_asset_15.webp" alt="" class="absolute -right-4 top-0 w-20 sm:w-24 opacity-80 select-none pointer-events-none" />
  </div>

  <!-- Timeline / Horarios con iconos originales del PDF -->
  <div class="grid grid-cols-4 gap-2 my-6">
    <div class="text-center">
      <img src="/assets/icon_llegada.png" alt="" class="h-14 w-auto mx-auto mb-1 object-contain select-none" />
      <p class="font-serif text-[#1a3256] text-sm font-semibold tracking-wide m-0">Llegada</p>
      <p class="font-serif text-[#2c4a7c] text-xs font-bold mt-0.5">3:30PM</p>
    </div>
    <div class="text-center">
      <img src="/assets/icon_ceremonia.png" alt="" class="h-14 w-auto mx-auto mb-1 object-contain select-none" />
      <p class="font-serif text-[#1a3256] text-sm font-semibold tracking-wide m-0">Ceremonia</p>
      <p class="font-serif text-[#2c4a7c] text-xs font-bold mt-0.5">3:45PM</p>
    </div>
    <div class="text-center">
      <img src="/assets/icon_fiesta.png" alt="" class="h-14 w-auto mx-auto mb-1 object-contain select-none" />
      <p class="font-serif text-[#1a3256] text-sm font-semibold tracking-wide m-0">Fiesta</p>
      <p class="font-serif text-[#2c4a7c] text-xs font-bold mt-0.5">5:00PM</p>
    </div>
    <div class="text-center">
      <img src="/assets/icon_salida.png" alt="" class="h-14 w-auto mx-auto mb-1 object-contain select-none" />
      <p class="font-serif text-[#1a3256] text-sm font-semibold tracking-wide m-0">Salida</p>
      <p class="font-serif text-[#2c4a7c] text-xs font-bold mt-0.5">11:00PM</p>
    </div>
  </div>

  <!-- Tarjeta Dress Code azul grisáceo con siluetas y esquinas originales -->
  <div class="dc-card relative bg-[#5b7ba6] rounded-xl px-5 py-6 my-8 text-white shadow-[-8px_8px_0_0_#8FA6C4] overflow-visible">
    <!-- Esquinas ornamentales blancas -->
    <img src="/assets/dresscode_corner.webp" alt="" class="absolute top-2 left-2 w-10 h-10 object-contain opacity-90 pointer-events-none" />
    <img src="/assets/dresscode_corner_alt.webp" alt="" class="absolute top-2 right-2 w-10 h-10 object-contain opacity-90 pointer-events-none" />
    <img src="/assets/dresscode_corner_alt.webp" alt="" class="absolute bottom-2 left-2 w-10 h-10 object-contain opacity-90 pointer-events-none" />
    <img src="/assets/dresscode_corner.webp" alt="" class="absolute bottom-2 right-2 w-10 h-10 object-contain opacity-90 pointer-events-none" />

    <div class="text-center relative z-10">
      <img
        src="/assets/caligrafia_dresscode.webp"
        alt="Dress Code"
        class="w-44 mx-auto h-auto object-contain brightness-0 invert drop-shadow-sm mb-1"
      />
      <p class="font-serif text-white font-bold tracking-[0.25em] text-lg mb-4">GALA</p>

      <div class="grid grid-cols-2 gap-4 items-end mt-2">
        <div class="flex flex-col items-center">
          <p class="font-serif text-white text-base tracking-wider mb-2 font-medium">Mujeres</p>
          <img
            src="/assets/dresscode_vestido.webp"
            alt="Silueta Vestido de Gala"
            class="h-56 w-auto object-contain opacity-100 drop-shadow"
          />
        </div>
        <div class="flex flex-col items-center">
          <p class="font-serif text-white text-base tracking-wider mb-2 font-medium">Hombres</p>
          <img
            src="/assets/dresscode_traje.webp"
            alt="Silueta Traje de Gala"
            class="h-56 w-auto object-contain opacity-100 drop-shadow"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Paleta de colores -->
  <div class="my-6">
    <div class="flex flex-wrap gap-2 justify-center my-2">
      {sugeridos.map((c) => (
        <span
          class="w-7 h-7 rounded-full inline-block shadow-xs border border-white/80"
          style={`background-color: ${c}`}
        />
      ))}
    </div>
    <p class="font-serif text-[#1a3256] text-sm font-semibold tracking-wider mt-2">
      Colores sugeridos
    </p>

    <!-- Colores no permitidos: fila con una sola línea roja horizontal que la cruza -->
    <div class="relative flex gap-2.5 justify-center items-center mt-6 mb-2 w-max mx-auto px-1">
      {prohibidos.map((c) => (
        <span
          class="w-7 h-7 rounded-full inline-block shadow-xs border border-[#1a3256]/20"
          style={`background-color: ${c}`}
        />
      ))}
      <span class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-[2px] bg-red-600"></span>
    </div>
    <p class="font-serif text-xs text-[#2c4a7c] max-w-[34ch] mx-auto leading-relaxed opacity-90 mt-1">
      Colores para no utilizar este día. Serán los colores de la novia, el novio, damas y caballeros de honor.
    </p>
  </div>
</section>

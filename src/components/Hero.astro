---
/**
 * Hero.astro — Portada fiel 1:1 al PDF original
 */
---
<section class="hero" id="save-the-date">
  <!-- Ramo hortensias superior izquierdo (proporción dominante orgánica) -->
  <img
    src="/images/flower-corner-left.png"
    alt=""
    aria-hidden="true"
    class="flor flor--tl floating-flower"
    style="--float-delay: 0s;"
  />

  <!-- Ramo superior derecho (espejado simétrico exacto) -->
  <img
    src="/images/flower-corner-left.png"
    alt=""
    aria-hidden="true"
    class="flor flor--tr floating-flower"
    style="--float-delay: 1.2s;"
  />

  <div class="hero__inner">
    <!-- Monograma superior -->
    <img
      src="/images/monograma.png"
      alt="Monograma de Angel y Kenia"
      class="monograma"
      fetchpriority="high"
    />

    <!-- Marco ornamental limpio con las 4 volutas en las esquinas -->
    <div class="marco">
      <img src="/images/marco-tl.png" alt="" aria-hidden="true" class="esq esq--tl" />
      <img src="/images/marco-tr.png" alt="" aria-hidden="true" class="esq esq--tr" />
      <img src="/images/marco-bl.png" alt="" aria-hidden="true" class="esq esq--bl" />
      <img src="/images/marco-br.png" alt="" aria-hidden="true" class="esq esq--br" />

      <h1 class="save-date">
        <span class="save-date__save">SAVE</span>
        <span class="save-date__the">the</span>
        <span class="save-date__date">DATE</span>
      </h1>

      <p class="fecha">04.04.27</p>

      <p class="versiculo">1 Corintios 13:13</p>
    </div>

    <!-- Peonía inferior integrada orgánicamente -->
    <img
      src="/images/flower-peony.png"
      alt=""
      aria-hidden="true"
      class="peonia floating-flower"
      style="--float-delay: 2s;"
    />

    <!-- Datos del evento -->
    <div class="evento">
      <p class="evento__fecha">Domingo 04 | Abril 2027</p>
      <p class="evento__hora">15:30 HRS</p>
      <p class="evento__lugar">Salón Bamboo</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    padding: 4rem 1.5rem 3rem;
    overflow: hidden;
    text-align: center;
    background: transparent;
  }

  /* Posicionamiento absoluto de los ramos florales superiores */
  .flor {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    width: 42%;
    max-width: 210px;
    height: auto;
  }
  .flor--tl {
    top: -10px;
    left: -10px;
  }
  .flor--tr {
    top: -10px;
    right: -10px;
    transform: scaleX(-1);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 340px;
    margin: 0 auto;
  }

  .monograma {
    display: block;
    width: 120px;
    height: auto;
    margin: 0 auto 1.8rem;
  }

  /* Marco ornamental */
  .marco {
    position: relative;
    padding: 2.2rem 1.4rem 1.4rem;
    border: 1px solid rgba(38, 56, 117, 0.35);
    background: transparent;
  }
  .esq {
    position: absolute;
    width: 48px;
    height: 48px;
    object-fit: contain;
    pointer-events: none;
  }
  .esq--tl { top: -24px; left: -24px; }
  .esq--tr { top: -24px; right: -24px; }
  .esq--bl { bottom: -24px; left: -24px; }
  .esq--br { bottom: -24px; right: -24px; }

  /* Tipografía oficial forzada (Sloop Script Pro) */
  .save-date {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem;
    margin: 0;
    color: var(--ak-marino, #263875);
  }
  .save-date__save,
  .save-date__date {
    font-family: 'Sloop Script Pro', 'Dancing Script', cursive;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.25em;
  }
  .save-date__the {
    font-family: 'Sloop Script Pro', 'Dancing Script', cursive;
    font-size: 1.7rem;
    line-height: 1;
  }

  .fecha {
    margin: 0.9rem 0 0;
    font-family: 'The Seasons', 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 8.5vw, 2.4rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--ak-marino, #263875);
  }

  .versiculo {
    margin: 0.9rem 0 0;
    text-align: right;
    font-family: 'The Seasons', 'Cormorant Garamond', serif;
    font-size: 0.85rem;
    font-style: italic;
    letter-spacing: 0.1em;
    color: var(--ak-marino, #263875);
  }

  /* Peonía inferior */
  .peonia {
    display: block;
    width: 95%;
    max-width: 340px;
    height: auto;
    margin: -1.8rem auto 0.8rem -1.4rem;
  }

  /* Bloque de fecha y salón */
  .evento {
    margin-top: 1.8rem;
  }
  .evento__fecha,
  .evento__hora,
  .evento__lugar {
    font-family: 'The Seasons', 'Cormorant Garamond', serif;
    color: var(--ak-marino, #263875);
    margin: 0;
  }
  .evento__fecha {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .evento__hora {
    margin-top: 0.3rem;
    font-size: 0.95rem;
    font-weight: 700;
  }
  .evento__lugar {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    opacity: 0.9;
  }
</style>

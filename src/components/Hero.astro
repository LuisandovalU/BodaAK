---
/**
 * Hero.astro — Versión basada en la captura del PDF (page‑01.png).
 * El fondo del hero es la imagen exacta del PDF, por lo que la posición
 * de los elementos visuales (hortensias, marco, peonía, etc.) queda idéntica.
 * Sobre él se añaden solo los textos necesarios (SAVE the DATE, fecha,
 * versículo y datos del evento) con tipografías locales.
 */
---
import SaveDateTitle from "./SaveDateTitle.astro";
<section class="hero" aria-label="Save the date – Ángel y Kenia">
  <div class="overlay">
    <SaveDateTitle />
    <p class="fecha">04.04.27</p>
    <p class="versiculo">1 Corintios 13:13</p>
    <p class="evento__fecha">Domingo 04 | Abril 2027</p>
    <p class="evento__hora">15:30 HRS</p>
    <p class="evento__lugar">Salón Bamboo</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    max-width: var(--ak-card-max);
    height: 900px;               /* altura aproximada del hero del PDF */
    margin: 0 auto;
    background: url('/scratch/pdf_pages/page-01.png') top center / contain no-repeat;
    background-color: var(--ak-card-bg);
    overflow: hidden;
  }
  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--ak-marino);
    text-align: center;
    padding: 2rem;
  }
  .save-date {
    display: flex;
    gap: .4rem;
    font-family: 'Sloop Script Pro','Dancing Script',cursive;
    font-weight: 700;
    color: var(--ak-marino);
    margin-bottom: .5rem;
  }
  .save-date__save,
  .save-date__date { font-size: 1.6rem; letter-spacing: .25em; }
  .save-date__the { font-size: 2.2rem; }
  .save-date-title { max-width: 100%; height: auto; margin-bottom: .5rem; }
  .fecha { font-family: 'The Seasons','Cormorant Garamond',serif; font-size: 2rem; font-weight:700; margin:.5rem 0; }
  .versiculo { font-family: 'The Seasons','Cormorant Garamond',serif; font-size:.85rem; font-style:italic; margin-bottom:1rem; }
  .evento__fecha,.evento__hora,.evento__lugar { font-family: 'The Seasons','Cormorant Garamond',serif; font-size:1rem; margin:.2rem 0; }
</style>

---
/**
 * Hero.astro — Portada fiel 1:1 al PDF original
 */
---

<section class="hero" id="save-the-date">
  <!-- Flor 1: Ramo superior izquierdo -->
  <img
    src="/images/flor-1.webp"
    alt=""
    aria-hidden="true"
    class="flor flor--tl floating-flower"
    style="--flower-origin: top left; --float-delay: 0s;"
  />

  <!-- Flor 2: Ramo superior derecho -->
  <img
    src="/images/flor-2.webp"
    alt=""
    aria-hidden="true"
    class="flor flor--tr floating-flower"
    style="--flower-origin: top right; --float-delay: 1.2s;"
  />

  <!-- Flor 3: Ramo floral complementario superior -->
  <img
    src="/images/flor-3.webp"
    alt=""
    aria-hidden="true"
    class="flor flor--top-cluster floating-flower"
    style="--flower-origin: top left; --float-delay: 0.6s;"
  />

  <!-- El PDF repite un racimo más ligero en la esquina superior derecha. -->
  <img
    src="/images/flor-3.webp"
    alt=""
    aria-hidden="true"
    class="flor flor--top-right-cluster"
  />

  <!-- Flor 4: Borde lateral izquierdo (hojas cruzando el marco) -->
  <img
    src="/images/flor-4.webp"
    alt=""
    aria-hidden="true"
    class="flor flor--side-l floating-flower"
    style="--flower-origin: center left; --float-delay: 0.8s;"
  />

  <!-- Flor 5: Borde lateral derecho (ramito floral sobre el marco) -->
  <img
    src="/images/flor-5.webp"
    alt=""
    aria-hidden="true"
    class="flor flor--side-r floating-flower"
    style="--flower-origin: center right; --float-delay: 1.6s;"
  />

  <div class="hero__inner">
    <!-- Monograma superior -->
    <img
      src="/images/monograma.png"
      alt="Monograma de Angel y Kenia"
      class="monograma"
      fetchpriority="high"
    />

    <!-- Marco ornamental limpio con las 4 volutas en las esquinas -->
    <div class="marco">
      <img
        src="/images/marco-tl.png"
        alt=""
        aria-hidden="true"
        class="esq esq--tl"
      />
      <img
        src="/images/marco-tr.png"
        alt=""
        aria-hidden="true"
        class="esq esq--tr"
      />
      <img
        src="/images/marco-bl.png"
        alt=""
        aria-hidden="true"
        class="esq esq--bl"
      />
      <img
        src="/images/marco-br.png"
        alt=""
        aria-hidden="true"
        class="esq esq--br"
      />

      <!-- Imagen oficial SAVE the DATE -->
      <div class="save-date-wrap">
        <img
          src="/images/save-the-date.png"
          alt="SAVE the DATE"
          class="save-date-img"
        />
      </div>

      <p class="fecha">04.04.27</p>

      <p class="versiculo">1 Corintios 13:13</p>
    </div>

    <!-- Flor 6: Centro del Hero con z-index superior POR ENCIMA del marco -->
    <img
      src="/images/flor-6.webp"
      alt=""
      aria-hidden="true"
      class="flor-centro floating-flower"
      style="--flower-origin: center center; --float-delay: 2.2s;"
    />

    <div class="evento">
      <p class="evento__fecha">Domingo 04 | Abril 2027</p>
      <p class="evento__hora">15:30 HRS</p>
      <p class="evento__lugar">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 2a7 7 0 0 0-7 7c0 5.06 7 13 7 13s7-7.94 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z" />
        </svg>
        Salón Bamboo
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    padding: 1.25rem 0 2.25rem;
    overflow: hidden;
    text-align: center;
    background: transparent;
  }

  /* Posicionamiento absoluto de los ramos florales */
  .flor {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    height: auto;
  }
  .flor--tl {
    top: 1.5rem;
    left: -2%;
    width: 43%;
    max-width: 215px;
  }
  .flor--tr {
    top: -2.6rem;
    left: 47%;
    width: 32%;
    max-width: 160px;
  }
  .flor--top-cluster {
    top: -6rem;
    left: -7%;
    width: 40%;
    max-width: 200px;
    opacity: 0.85;
  }
  .flor--top-right-cluster {
    top: -6.5rem;
    right: -8%;
    width: 32%;
    max-width: 160px;
    opacity: 0.85;
    transform: scaleX(-1);
  }
  .flor--side-l {
    top: 33%;
    left: -9%;
    width: 37%;
    max-width: 185px;
    opacity: 0.95;
  }
  .flor--side-r {
    top: 42%;
    right: -3%;
    width: 23%;
    max-width: 115px;
    opacity: 0.95;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    width: 76%;
    max-width: 390px;
    margin: 6.7rem auto 0;
  }

  .monograma {
    display: block;
    width: 96px;
    height: auto;
    margin: 0 auto 1.3rem;
  }

  /* Marco ornamental */
  .marco {
    position: relative;
    padding: 2.4rem 0.85rem 1.45rem;
    background: transparent;
  }
  .esq {
    position: absolute;
    width: 48%;
    height: auto;
    object-fit: contain;
    pointer-events: none;
  }
  .esq--tl {
    top: 0;
    left: 0;
  }
  .esq--tr {
    top: 0;
    right: 0;
  }
  .esq--bl {
    bottom: 0;
    left: 0;
  }
  .esq--br {
    bottom: 0;
    right: 0;
  }

  /* Imagen oficial SAVE the DATE */
  .save-date-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
  }
  .save-date-img {
    display: block;
    width: 49%;
    max-width: 165px;
    height: auto;
    object-fit: contain;
  }

  .fecha {
    margin: 0.55rem 0 0;
    font-family: "The Seasons", "Cormorant Garamond", serif;
    font-size: clamp(1.45rem, 6.5vw, 1.8rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ak-marino, #263875);
    text-align: center;
  }

  .versiculo {
    margin: 1rem 0.1rem 0 0;
    text-align: right;
    font-family: "The Seasons", "Cormorant Garamond", serif;
    font-size: 0.78rem;
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ak-marino, #263875);
  }

  /* Flor 6: Centro del Hero con z-index superior POR ENCIMA del marco */
  .flor-centro {
    position: relative;
    z-index: 10;
    display: block;
    width: 100%;
    max-width: 390px;
    height: auto;
    margin: -3rem auto 0;
    pointer-events: none;
    filter: drop-shadow(0 6px 14px rgba(38, 56, 117, 0.1));
  }

  .evento {
    margin-top: 2rem;
    color: var(--ak-marino, #263875);
  }
  .evento p {
    margin: 0;
    font-family: "The Seasons", "Cormorant Garamond", serif;
    font-weight: 700;
  }
  .evento__fecha {
    font-size: clamp(1.12rem, 5vw, 1.42rem);
    letter-spacing: 0.01em;
  }
  .evento__hora {
    margin-top: 0.2rem !important;
    font-size: clamp(1rem, 4.4vw, 1.22rem);
  }
  .evento__lugar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.28rem;
    margin-top: 0.25rem !important;
    font-size: clamp(1.15rem, 5.2vw, 1.46rem);
  }
  .evento__lugar svg {
    width: 1.05em;
    height: 1.05em;
    fill: currentColor;
  }
</style>

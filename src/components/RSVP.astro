---
/** Confirmación de asistencia: respuesta, nombre y vínculo con la pareja. */
---

<section class="seccion rsvp" id="rsvp">
  <img loading="lazy" decoding="async" src="/images/flor-14.webp" alt="" aria-hidden="true" class="flor-lateral floating-flower" style="--flower-origin: center right; --float-delay: 1.7s;" />
  <img loading="lazy" decoding="async" src="/images/caligrafia-asistencia.webp" alt="Confirmación de asistencia" class="confirmacion-caps" data-reveal="fade-up" />
  <p class="intro" data-reveal="fade-up">Podrás confirmar tu asistencia hasta el 15 de diciembre de 2026. Tu respuesta nos ayudará a preparar cada detalle con cariño.</p>

  <div id="rsvp-inicio" class="rsvp-paso" data-reveal="fade-up">
    <p class="pregunta">¿Podrás acompañarnos?</p>
    <div class="opciones-iniciales">
      <button id="rsvp-confirmar" type="button" class="btn-primario">Confirmo</button>
      <button id="rsvp-no-asistir" type="button" class="btn-secundario">No podré asistir</button>
    </div>
  </div>

  <div id="rsvp-confirmacion" class="rsvp-paso" hidden>
    <p class="gracias">¡Gracias por tu confirmación!</p>
    <div class="campos-nombre">
      <label class="campo" for="rsvp-nombres-si">
        <span class="campo__label">Nombre(s)</span>
        <input id="rsvp-nombres-si" type="text" autocomplete="given-name" placeholder="Ej. María Fernanda" />
      </label>
      <label class="campo" for="rsvp-apellidos-si">
        <span class="campo__label">Apellidos</span>
        <input id="rsvp-apellidos-si" type="text" autocomplete="family-name" placeholder="Ej. López García" />
      </label>
    </div>
    <p class="pregunta">Cuéntanos cómo nos acompañas:</p>
    <div class="tipos" role="group" aria-label="Vínculo con Ángel y Kenia">
      <button type="button" class="btn-tipo" data-tipo="familia">Soy familiar de Ángel y Kenia</button>
      <button type="button" class="btn-tipo" data-tipo="amistad">Soy amistad de Ángel y Kenia</button>
    </div>
    <div id="rsvp-panel-familiar" class="panel" hidden><p class="nos-vemos">¡Nos vemos ese día!</p></div>
    <div id="rsvp-panel-amistad" class="panel" hidden>
      <div class="costo">
        <p class="costo__titulo">Costo por boleto individual</p>
        <p class="costo__monto">$350 pesos</p>
      </div>
      <p class="paso-pago"><strong>Paso 1.</strong> Haz tu depósito o transferencia a esta cuenta:</p>
      <div class="banco"><p class="dato">CLABE: 638180010146605599</p><p class="dato">Nombre: Ángel Adrián Zamora Morales</p><p class="dato">Banco: NU</p><p class="dato">Concepto: BODA</p></div>
      <p class="paso-pago"><strong>Paso 2.</strong> Envía tu comprobante de pago por WhatsApp al número de Samuel Montalvo (56 2086 2829):</p>
      <a class="enviar" href="https://wa.me/525620862829" target="_blank" rel="noopener noreferrer" aria-label="Enviar comprobante por WhatsApp a Samuel Montalvo">
        <span class="enviar__texto">Envía tu comprobante a</span>
        <span class="enviar__nombre">Samuel Montalvo</span>
      </a>
      <p class="nos-vemos">¡Nos vemos ese día!</p>
    </div>
  </div>

  <div id="rsvp-declinacion" class="rsvp-paso" hidden>
    <p class="gracias">Lo lamentamos mucho</p>
    <p class="mensaje-declinacion">Entendemos que no puedas acompañarnos. Te tendremos presente en este día tan especial.</p>
    <div class="campos-nombre">
      <label class="campo" for="rsvp-nombres-no">
        <span class="campo__label">Nombre(s)</span>
        <input id="rsvp-nombres-no" type="text" autocomplete="given-name" placeholder="Ej. María Fernanda" />
      </label>
      <label class="campo" for="rsvp-apellidos-no">
        <span class="campo__label">Apellidos</span>
        <input id="rsvp-apellidos-no" type="text" autocomplete="family-name" placeholder="Ej. López García" />
      </label>
    </div>
    <button id="rsvp-guardar-no" type="button" class="btn-primario">Enviar respuesta</button>
    <p id="rsvp-no-guardado" class="nos-vemos" hidden>Gracias por avisarnos.</p>
  </div>

  <p id="rsvp-error" class="error" role="alert" aria-live="polite"></p>
</section>

<style>
  .rsvp { padding-bottom: 3.25rem; overflow: hidden; }
  .confirmacion-caps { display: block; width: 80%; max-width: 250px; margin: 0 auto 0.2rem; }
  .flor-lateral { position: absolute; top: -1%; right: -44px; width: 26%; max-width: 115px; height: auto; opacity: 0.6; z-index: 0; pointer-events: none; }
  .intro, .mensaje-declinacion { max-width: 34ch; margin: 0 auto; font-family: "Fraunces", "Cormorant Garamond", serif; font-size: 0.95rem; line-height: 1.75; color: var(--ak-principal); }
  .rsvp-paso { max-width: 330px; margin: 1.85rem auto 0; }
  .pregunta { margin: 0 0 0.85rem; font-family: "Fraunces", "Cormorant Garamond", serif; font-size: 0.74rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ak-acero); }
  .opciones-iniciales, .tipos { display: grid; gap: 0.7rem; }
  .btn-secundario, .btn-tipo { width: 100%; padding: 0.85rem 1rem; border: 1px solid rgba(38, 56, 117, 0.35); border-radius: 0; background: rgba(255, 255, 255, 0.72); font-family: "Fraunces", "Cormorant Garamond", serif; font-size: 0.98rem; font-weight: 500; color: var(--ak-principal); cursor: pointer; }
  .btn-secundario:hover, .btn-tipo:hover { border-color: var(--ak-boton); color: var(--ak-marino); }
  .campo { display: block; margin: 1.25rem 0; text-align: left; }
  .campos-nombre { display: grid; gap: 0.9rem; margin: 1.25rem 0; }
  .campos-nombre .campo { margin: 0; }
  .campo__label { display: block; margin-bottom: 0.35rem; font-family: "Fraunces", "Cormorant Garamond", serif; font-size: 0.74rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ak-principal); }
  .campo input { box-sizing: border-box; width: 100%; padding: 0.65rem 0.8rem; border: 1px solid rgba(38, 56, 117, 0.3); border-radius: 4px; background: rgba(255, 255, 255, 0.9); font-family: "Fraunces", "Cormorant Garamond", serif; font-size: 1rem; color: var(--ak-marino); }
  .campo input:focus { outline: none; border-color: var(--ak-boton); box-shadow: 0 0 0 3px rgba(82, 111, 157, 0.18); }
  .gracias { margin: 0; font-family: "Fraunces", "Cormorant Garamond", serif; font-size: 1.5rem; font-weight: 500; line-height: 1.3; letter-spacing: 0.02em; color: var(--ak-marino); }
  .mensaje-declinacion { margin-top: 0.85rem; }
  .panel { margin-top: 1.6rem; animation: aparecer 0.45s ease both; }
  @keyframes aparecer { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .costo { padding: 0.9rem 1rem; border: 1px solid rgba(38, 56, 117, 0.28); border-radius: 8px; background: rgba(38, 56, 117, 0.06); text-align: center; }
  .costo__titulo { font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .costo__monto { margin-top: 0.2rem; font-size: 1.8rem; font-weight: 700; }
  .paso-pago { margin: 1rem 0 0.6rem; font-size: 0.95rem; line-height: 1.4; text-align: left; }
  .banco { padding: 1.2rem 1.15rem; border: 1px solid rgba(38, 56, 117, 0.28); border-radius: 8px; background: rgba(255, 255, 255, 0.82); text-align: left; }
  .banco .dato + .dato { margin-top: 0.4rem; padding-top: 0.4rem; border-top: 1px solid rgba(38, 56, 117, 0.12); }
  .enviar { display: block; width: fit-content; margin: 1.3rem auto 0; padding: 0.55rem 1.1rem; border: 1px solid rgba(38, 56, 117, 0.28); border-radius: 999px; background: rgba(255, 255, 255, 0.6); font-family: "Fraunces", "Cormorant Garamond", serif; line-height: 1.35; text-align: center; text-decoration: none; color: var(--ak-marino); transition: background-color 0.15s ease, transform 0.15s ease; }
  .enviar:hover, .enviar:focus-visible { background: rgba(255, 255, 255, 0.9); outline: none; transform: translateY(-1px); }
  .enviar__texto { display: block; font-size: 0.95rem; font-weight: 400; color: var(--ak-principal); }
  .enviar__nombre { display: block; font-size: 1.05rem; font-weight: 500; letter-spacing: 0.04em; }
  .nos-vemos { margin: 1.5rem 0 0; font-family: "Fraunces", "Cormorant Garamond", serif; font-size: clamp(1.35rem, 6.5vw, 1.7rem); font-weight: 500; letter-spacing: 0.08em; color: var(--ak-marino); }
  .error { min-height: 1.1em; max-width: 330px; margin: 0.7rem auto 0; font-family: "Fraunces", "Cormorant Garamond", serif; font-size: 0.76rem; font-weight: 500; color: #a5352b; }
  button:disabled { cursor: wait; opacity: 0.65; }
  @media (prefers-reduced-motion: reduce) { .panel { animation: none; } }
</style>

<script>
  import { submitRSVP } from "../lib/aws";

  const inicio = document.getElementById("rsvp-inicio");
  const confirmacion = document.getElementById("rsvp-confirmacion");
  const declinacion = document.getElementById("rsvp-declinacion");
  const errorBox = document.getElementById("rsvp-error");
  const nombresSi = document.getElementById("rsvp-nombres-si") as HTMLInputElement | null;
  const apellidosSi = document.getElementById("rsvp-apellidos-si") as HTMLInputElement | null;
  const nombresNo = document.getElementById("rsvp-nombres-no") as HTMLInputElement | null;
  const apellidosNo = document.getElementById("rsvp-apellidos-no") as HTMLInputElement | null;
  const panelFamiliar = document.getElementById("rsvp-panel-familiar");
  const panelAmistad = document.getElementById("rsvp-panel-amistad");
  const guardadoNo = document.getElementById("rsvp-no-guardado");
  const botonesTipo = document.querySelectorAll<HTMLButtonElement>(".btn-tipo");
  const botonNo = document.getElementById("rsvp-guardar-no") as HTMLButtonElement | null;

  function mostrarPaso(paso: HTMLElement | null) {
    [inicio, confirmacion, declinacion].forEach((elemento) => { if (elemento) elemento.hidden = elemento !== paso; });
    if (errorBox) errorBox.textContent = "";
    paso?.scrollIntoView({ behavior: "smooth", block: "center" });
  }

  type Persona = { nombres: string; apellidos: string };

  function personaValida(inputNombres: HTMLInputElement | null, inputApellidos: HTMLInputElement | null): Persona | null {
    const nombres = inputNombres?.value.trim().replace(/\s+/g, " ") ?? "";
    const apellidos = inputApellidos?.value.trim().replace(/\s+/g, " ") ?? "";
    if (!nombres) {
      if (errorBox) errorBox.textContent = "Por favor escribe tu nombre.";
      inputNombres?.focus();
      return null;
    }
    if (!apellidos) {
      if (errorBox) errorBox.textContent = "Por favor escribe tus apellidos.";
      inputApellidos?.focus();
      return null;
    }
    if (errorBox) errorBox.textContent = "";
    return { nombres, apellidos };
  }

  async function guardar(persona: Persona, asistencia: "si" | "no", grupo: "familia" | "amistad" | "" = "") {
    try {
      await submitRSVP({ ...persona, nombre: `${persona.nombres} ${persona.apellidos}`, asistencia, grupo });
      return true;
    } catch {
      if (errorBox) errorBox.textContent = "No pudimos registrar tu respuesta. Inténtalo de nuevo.";
      return false;
    }
  }

  document.getElementById("rsvp-confirmar")?.addEventListener("click", () => mostrarPaso(confirmacion));
  document.getElementById("rsvp-no-asistir")?.addEventListener("click", () => mostrarPaso(declinacion));

  botonesTipo.forEach((boton) => {
    boton.addEventListener("click", async () => {
      const persona = personaValida(nombresSi, apellidosSi);
      if (!persona) return;
      const grupo = boton.dataset.tipo as "familia" | "amistad";
      botonesTipo.forEach((otro) => { otro.disabled = true; });
      const guardado = await guardar(persona, "si", grupo);
      if (!guardado) {
        botonesTipo.forEach((otro) => { otro.disabled = false; });
        return;
      }
      if (panelFamiliar) panelFamiliar.hidden = grupo !== "familia";
      if (panelAmistad) panelAmistad.hidden = grupo !== "amistad";
    });
  });

  botonNo?.addEventListener("click", async () => {
    const persona = personaValida(nombresNo, apellidosNo);
    if (!persona) return;
    botonNo.disabled = true;
    const guardado = await guardar(persona, "no");
    botonNo.disabled = false;
    if (guardado) {
      botonNo.hidden = true;
      if (guardadoNo) guardadoNo.hidden = false;
    }
  });
</script>

---
/**
 * Detalles.astro — "Detalles" del evento
 * ---------------------------------------------------------------------------
 * En el PDF: título en script y 4 iconos con nombre y hora
 * (Llegada · Ceremonia · Fiesta · Salida), todos del set original de assets.
 * ---------------------------------------------------------------------------
 */
const momentos = [
  {
    icono: "/images/icon-detalles-llegada.png",
    nombre: "Llegada",
    hora: "3:30PM",
  },
  {
    icono: "/images/icon-detalles-ceremonia.png",
    nombre: "Ceremonia",
    hora: "3:45PM",
  },
  {
    icono: "/images/icon-detalles-fiesta.png",
    nombre: "Fiesta",
    hora: "5:00PM",
  },
  {
    icono: "/images/icon-detalles-salida.png",
    nombre: "Salida",
    hora: "10:30PM",
  },
];
---

<section class="seccion detalles relative overflow-hidden" id="detalles">
  <!-- Composiciones florales laterales, como en la sección del PDF. -->
    <img loading="lazy" decoding="async"
      src="/images/flor-10.webp"
      alt=""
      aria-hidden="true"
      class="flor-detalles flor-detalles--izquierda"
      data-reveal="slide-left"
      style="top: 0.8rem; left: -22%; width: 36%; max-width: 185px; height: auto; opacity: 1; z-index: 999; pointer-events: none; filter: blur(0px); transform: none;"
    />
    <img loading="lazy" decoding="async"
      src="/images/flor-10.webp"
      alt=""
      aria-hidden="true"
      class="flor-detalles flor-detalles--derecha"
      data-reveal="slide-right"
      style="position:absolute; top:1rem; right:-18%; width:36%; max-width:185px; height:auto; opacity:0.95; z-index:999; pointer-events:none;"
    />

  <img loading="lazy" decoding="async" src="/images/caligrafia-detalles.webp" alt="Detalles" class="titulo-seccion detalles__titulo" data-reveal="fade-up" style="width:80%; max-width:200px; display:block; margin:auto;" />

  <div class="momentos detalles__contenido" data-reveal="fade-up">
    {
      momentos.map((m) => (
        <div class="momento">
          <img
            src={m.icono}
            alt=""
            aria-hidden="true"
            class="momento__icono"
            loading="lazy"
          />
          <span class="momento__nombre">{m.nombre}</span>
          <span class="momento__hora">{m.hora}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .detalles {
    position: relative;
    isolation: isolate;
    padding-top: 6.5rem;
    padding-bottom: 3.5rem;
  }

  .flor-detalles {
    position: absolute;
    top: 1rem;
    width: 36%;
    max-width: 185px;
    height: auto;
    opacity: 0.86;
    z-index: 999;
    pointer-events: none;
  }

  .flor-detalles--izquierda {
    left: -20%;
    scale: -1 1;
    transform-origin: top center;
  }

  .flor-detalles--derecha {
    right: -18%;
    rotate: 20deg;
    transform-origin: 41%;
  }

  .detalles__titulo,
  .detalles__contenido {
    position: relative;
    z-index: 1;
  }

  .detalles__titulo {
    font-size: clamp(3.35rem, 17vw, 4.6rem);
  }

  .momentos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
    max-width: 430px;
    margin: 3rem auto 0;
  }

  .momento {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .momento__icono {
    width: clamp(52px, 14vw, 72px);
    height: clamp(52px, 14vw, 72px);
    object-fit: contain;
  }

  .momento__nombre {
    font-family: "The Seasons", "Cormorant Garamond", serif;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ak-marino);
  }

  .momento__hora {
    font-family: "The Seasons", "Cormorant Garamond", serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ak-marino);
    opacity: 0.85;
    font-variant-numeric: tabular-nums;
  }
</style>

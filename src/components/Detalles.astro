---
/**
 * Detalles.astro — "Detalles" del evento
 * ---------------------------------------------------------------------------
 * En el PDF: título en script y 4 iconos con nombre y hora
 * (Llegada · Ceremonia · Fiesta · Salida), todos del set original de assets.
 * ---------------------------------------------------------------------------
 */
const momentos = [
  { icono: '/images/icon-detalles-llegada.png', nombre: 'Llegada', hora: '3:30PM' },
  { icono: '/images/icon-detalles-ceremonia.png', nombre: 'Ceremonia', hora: '3:45PM' },
  { icono: '/images/icon-detalles-fiesta.png', nombre: 'Fiesta', hora: '5:00PM' },
  { icono: '/images/icon-detalles-salida.png', nombre: 'Salida', hora: '11:00PM' },
];
---
<section class="seccion detalles" id="detalles">
  <h2 class="titulo-seccion">Detalles</h2>

  <div class="momentos">
    {
      momentos.map((m) => (
        <div class="momento">
          <img src={m.icono} alt="" aria-hidden="true" class="momento__icono" loading="lazy" />
          <span class="momento__nombre">{m.nombre}</span>
          <span class="momento__hora">{m.hora}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .detalles {
    padding-top: 2.25rem;
  }

  .momentos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
    max-width: 340px;
    margin: 1.6rem auto 0;
  }

  .momento {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
  }

  .momento__icono {
    width: clamp(38px, 11vw, 52px);
    height: clamp(38px, 11vw, 52px);
    object-fit: contain;
  }

  .momento__nombre {
    font-family: 'The Seasons', 'Cormorant Garamond', serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ak-marino);
  }

  .momento__hora {
    font-family: 'The Seasons', 'Cormorant Garamond', serif;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ak-marino);
    opacity: 0.85;
    font-variant-numeric: tabular-nums;
  }
</style>

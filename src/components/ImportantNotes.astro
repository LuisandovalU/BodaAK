---
/**
 * ImportantNotes.astro — Importante
 * ---------------------------------------------------------------------------
 * Lista elegante con los 4 avisos (textos exactos).
 * ---------------------------------------------------------------------------
 */
const avisos = [
  {
    icono: '/images/icon-adults.png',
    titulo: 'FIESTA PARA ADULTOS:',
    texto:
      'Amamos a los niños pero es un evento para adultos, agradecemos tu comprensión para dejarlos en casa.',
  },
  {
    icono: '/images/icon-parking.png',
    titulo: 'VALET PARKING $70:',
    texto: 'No hay estacionamiento.',
  },
  {
    icono: '/images/icon-taylor.png',
    titulo: 'MOMENTO ESPECIAL:',
    texto: 'Conocer de memoria la letra de Love Story de Taylor Swift.',
  },
  {
    icono: '/images/icon-heart.png',
    titulo: 'INVITACIÓN INTRANSFERIBLE:',
    texto: 'Tu boleto e invitación es personal. Gracias.',
  },
];
---
<section class="seccion importante relative overflow-hidden" id="importante">
  <!-- Flor 16: Decoración floral final de avisos importantes -->
    <img loading="lazy" decoding="async"
      src="/images/flor-16.webp"
      alt=""
      aria-hidden="true"
      class="flor-importante floating-flower"
      data-reveal="slide-left"
      style="--flower-origin: bottom left; --float-delay: 2.2s;"
    />

  <img loading="lazy" decoding="async" src="/images/caligrafia-importante.png" alt="Importante" class="titulo-seccion" data-reveal="fade-up" style="width:80%; max-width:200px; display:block; margin:auto;" />

  <ol class="avisos">
    {
      avisos.map((a) => (
        <li class="aviso">
          <span class="aviso__icono">
            <img src={a.icono} alt="" aria-hidden="true" loading="lazy" />
          </span>
          <span class="aviso__cuerpo">
            <strong class="aviso__titulo">{a.titulo}</strong>{' '}
            <span class="aviso__texto">{a.texto}</span>
          </span>
        </li>
      ))
    }
  </ol>
</section>


  <style>
.importante {
    position: relative;
    padding-bottom: 3.5rem;
  }

    .flor-importante[data-astro-cid-orvbs7lc] {
        opacity: 0.85;
        z-index: 0;
        pointer-events: none;
        width: 26%;
        max-width: 161px;
        height: auto;
        position: absolute;
        top: -9.5rem;
        left: -9%;
        rotate: 90deg;
    }

  .avisos {
    position: relative;
    max-width: 340px;
    margin: 1.5rem auto 0;
    padding: 0 0 0 1.75rem;
    list-style: none;
    text-align: left;
    border-left: 1px solid rgba(38, 56, 117, 0.28);
  }

  .aviso {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
  }
  .aviso + .aviso {
    margin-top: 1.5rem;
  }

  /* Punto sobre la línea vertical. Sin halo: el punto es opaco y ya tapa la
     línea, así que un anillo de color sobre el papel solo ensuciaría. */
  .aviso::before {
    content: '';
    position: absolute;
    top: 0.55rem;
    left: calc(-1.75rem - 4.5px);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ak-marino);
  }

  .aviso__icono {
    flex: 0 0 auto;
    display: flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
  }
  .aviso__icono img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    opacity: 0.95;
  }

  .aviso__cuerpo {
    font-family: 'The Seasons', 'Cormorant Garamond', serif;
    font-size: 0.86rem;
    line-height: 1.7;
    color: var(--ak-principal);
  }
  .aviso__titulo {
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--ak-marino);
  }
  .aviso__texto {
    color: var(--ak-principal);
  }
</style>
